# =====================================================================
# QA Studio: environment variables
# Production: set these in Vercel › Project › Settings › Environment Variables.
# Local: copy to .env.local. Never commit real values.
# =====================================================================

# ---------- Database: Supabase (Project › Connect) ----------
# App runtime: the TRANSACTION pooler, port 6543 (works on serverless)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Migrations and first-run setup: the SESSION pooler, port 5432 (same host)
DIRECT_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Local development with no database: leave both unset (embedded Postgres in ./.pglite)
# DB_POOL_MAX=3

# ---------- Auth ----------
NEXTAUTH_URL=https://qa.zipstacc.com
NEXTAUTH_SECRET=                      # generate: openssl rand -base64 32

# Microsoft 365 / Entra ID app registration (leave blank to use passwords only)
# AZURE_AD_TENANT_ID: the zipstacc tenant ID (client stakeholders sign in as B2B guests)
#   or `organizations` (multi-tenant: clients sign in from their own tenant; list every tenant ID)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
# Google sign-in (Google Workspace accounts only; leave blank to turn off)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: show only accounts of this Workspace domain in Google's account chooser
GOOGLE_HD=
# Staff domains and tenant IDs (also editable under Admin › Login & SSO)
ALLOWED_EMAIL_DOMAINS=zipstacc.com
STAFF_TENANT_IDS=

# ---------- Notifications ----------
# Mailbox that sends notification emails (needs the Mail.Send application permission)
GRAPH_SENDER=qa-notifications@zipstacc.com
# Optional separate app for Graph; defaults to the AZURE_AD_* app
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Teams channel webhook (Workflows "Post to a channel when a webhook request is received")
TEAMS_WEBHOOK_URL=

# ---------- Jobs ----------
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=                          # generate: openssl rand -hex 32

# ---------- First-run setup only (npm run db:setup / GitHub "Database" workflow) ----------
ADMIN_EMAIL=amit.shirke@zipstacc.com
ADMIN_NAME=Amit Shirke
ADMIN_PASSWORD=                       # optional, 12+ characters; empty = Microsoft 365 sign-in only
CUSTCAP_PASSWORD=                     # optional shared client login, 12+ characters
UPPERCASE_PASSWORD=                   # optional shared client login, 12+ characters
CUSTCAP_SSO_DOMAINS=customer-capital.com
UPPERCASE_SSO_DOMAINS=

APP_TIMEZONE=Asia/Kolkata
